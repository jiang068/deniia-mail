# Cloudflare Pages 安全响应头
# 语法：路径 行，下一行起为 "Header: value"，空格分隔。
# 注释用 #（不是 /* */）。

/
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' unpkg.com cdnjs.cloudflare.com static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' *;
  Cache-Control: no-cache

# 静态资源可缓存（PJAX/整页加载复用，减少带宽与延迟）
/css/*
  Cache-Control: public, max-age=300

/js/*
  Cache-Control: public, max-age=300

/tailwind.css
  Cache-Control: public, max-age=300

/styles.css
  Cache-Control: public, max-age=300

/theme.boot.js
  Cache-Control: public, max-age=300